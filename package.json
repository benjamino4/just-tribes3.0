{
  "name": "tribes",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "workspaces": ["server", "web"],
  "scripts": {
    "build": "npm --prefix web install && npm --prefix web run build && npm --prefix server install",
    "start": "npm --prefix server start",
    "dev:web": "npm --prefix web run dev",
    "dev:server": "npm --prefix server start",
    "migrate": "MIGRATE=1 npm --prefix server start"
  }
}