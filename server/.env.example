# ---- required ----
DATABASE_URL=postgres://...
BOT_TOKEN=123456:ABC...
ADMIN_TOKEN=change-me-to-a-long-random-string

# ---- optional ----
APP_URL=https://your-app.onrender.com
TON_RECEIVE_ADDRESS=UQ...
TONCENTER_API_KEY=
TON_NETWORK=mainnet
ADMIN_BOT_TOKEN=
ADMIN_IDS=123456789
ALLOW_GUEST=0

# ---- Phase 1 ----
# Set MIGRATE=1 for ONE deploy to run migrations/001_phase1.sql, then remove it.
MIGRATE=0
# How often the background push flusher checks push_queue (seconds).
PUSH_FLUSH_SECONDS=20