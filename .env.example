# Copy to .env for local dev (never commit real secrets).
# --- Database (Aiven / any managed Postgres) ---
# sslmode=require in the URL is fine — the app strips it and sets SSL explicitly.
DATABASE_URL=postgres://user:pass@host:port/dbname?sslmode=require

# --- Telegram bot (from @BotFather) — enables Stars payments + initData auth ---
BOT_TOKEN=

# --- TON payments ---
TON_RECEIVE_ADDRESS=
TONCENTER_API_KEY=
TON_NETWORK=mainnet

# --- Local browser preview without Telegram (DO NOT enable in production) ---
ALLOW_GUEST=0

# --- Admin control plane ---
# A SEPARATE bot (make a second bot in @BotFather) that runs the admin console.
ADMIN_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to use the admin bot (find via @userinfobot).
ADMIN_IDS=
# Secret token for the web dashboard at /admin (pick a long random string).
ADMIN_TOKEN=

PORT=3000
