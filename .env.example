# Telegram
BOT_TOKEN=your_bot_token_from_botfather
ADMIN_TELEGRAM_ID=your_numeric_telegram_id
MINI_APP_URL=https://your-render-app.onrender.com

# Admin
# The admin panel is reachable ONLY from inside Telegram,
# ONLY by the ADMIN_TELEGRAM_ID above, ONLY with a valid
# session token issued per-visit by /api/me.
#
# No browser fallback. No secrets. No URL guessing.
ADMIN_PATH=aurum-console-x7k2

# Database (Neon)
# Use the exact connection string from your Neon dashboard.
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/yourdb?sslmode=verify-full

# AI Providers
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=

# Server
PORT=3000
NODE_ENV=production