# ============================================================
# TRIBES — environment
# Copy to .env and fill in. Never commit .env.
# ============================================================

# ---------- required ----------
DATABASE_URL=postgres://user:pass@host:5432/tribes
BOT_TOKEN=123456:ABC-DEF...
ADMIN_TOKEN=generate-a-long-random-string-here

# ---------- app ----------
APP_URL=https://your-app.onrender.com
NODE_ENV=production

# ---------- admin ----------
# Optional. If set, this bot receives /stats /ban /grant etc.
ADMIN_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the admin bot + REST.
ADMIN_IDS=

# ---------- TON ----------
TON_RECEIVE_ADDRESS=UQ...
TONCENTER_API_KEY=
TON_NETWORK=mainnet

# ---------- guest mode (dev only) ----------
# Set to 1 to allow playing without Telegram. NEVER 1 in production.
ALLOW_GUEST=0

# ---------- migrations ----------
# Set to 1 for ONE deploy to run migrations/*.sql in order, then remove.
MIGRATE=0

# ---------- push flusher ----------
PUSH_FLUSH_SECONDS=20