# ─── HUBRIS ───────────────────────────────────────────────
# Two SEPARATE Telegram bots share one database.
#   • BOT_TOKEN        → the public game bot (opens the Mini App)
#   • ADMIN_BOT_TOKEN  → the private admin bot (creator-only control)
# The admin bot is a different bot from BotFather, NOT a web panel.

# Public game bot
BOT_TOKEN=your_public_bot_token_from_botfather
MINI_APP_URL=https://your-render-app.onrender.com

# Admin control bot (a DIFFERENT bot token from BotFather)
ADMIN_BOT_TOKEN=your_private_admin_bot_token_from_botfather

# The one Telegram user who is the creator / admin.
# Only this numeric id can command the admin bot.
ADMIN_TELEGRAM_ID=your_numeric_telegram_id

# Database (Neon / Render Postgres)
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/yourdb?sslmode=verify-full

# AI Providers (used by the admin bot to rank outcomes)
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=

# Server
PORT=3000
NODE_ENV=production
